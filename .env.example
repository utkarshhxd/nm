# Copy to `.env`; docker-compose.dev.yml loads it into the dev container.
#
# DATABASE_URL and NM_DATABASE_URL are NOT here on purpose: compose sets them to the `postgres`
# service, which is the only address that resolves inside the container, and anything set here
# would be overridden anyway.
#
# Append the key, do not leave it empty - the server exits at startup without it:
#   printf 'NM_SECRET_KEY=%s\n' "$(bash scripts/dev.sh cargo run -q -- keys generate | tr -d '\r')" >> .env
