{
  "name": "nm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "typecheck": "tsc -b",
    "gen:api": "cargo run -q -- openapi > src/api/openapi.json && pnpm gen:schema",
    "gen:schema": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts && node -e \"const fs=require('node:fs'),f='src/api/schema.d.ts';fs.writeFileSync(f,['// SPDX-License-Identifier: AGPL-3.0-only',fs.readFileSync(f,'utf8')].join(String.fromCharCode(10)))\"",
    "test": "node --test scripts/*.test.mjs && playwright test --config playwright.unit.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "openapi-fetch": "0.17.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "otpauth": "9.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
